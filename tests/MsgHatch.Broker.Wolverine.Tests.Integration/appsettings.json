{
  // The RabbitMQ broker of the integration tests, for example a local container. Put the URI into appsettings.Local.json
  // next to this file, which git ignores, because a URI can hold a password. Each test is skipped while the URI is empty.
  // The tests declare only exclusive queues, which the broker deletes when the test closes its connection.
  "RabbitMqIntegration": {
    // Required: the AMQP URI of the broker, for example amqp://localhost:5672 for a local container with the default user.
    "Uri": ""
  }
}

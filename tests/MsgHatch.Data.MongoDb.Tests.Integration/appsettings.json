{
  // The MongoDB of the MongoDB integration tests (D183). Never put a password into this file: put the connection string
  // into appsettings.Local.json next to it, which git ignores. With an empty value, the tests start MongoDB in a
  // container with Testcontainers.
  "MongoDbIntegration": {
    // Optional: a connection string to the server, for example to the local container dev-mongo, a replica set with one
    // member: "mongodb://localhost:27017/?replicaSet=rs0". The tests create and drop only the databases whose names start
    // with the name of the test project, with each "." as "_".
    "ConnectionString": ""
  }
}

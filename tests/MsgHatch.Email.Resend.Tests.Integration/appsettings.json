{
  // The Resend account of the integration tests. Never put the API key into this file: put it into
  // appsettings.Local.json next to it, which git ignores. Each test is skipped while the API key is empty.
  "ResendIntegration": {
    // Required: an API key of the Resend account. The permission "sending access" is enough.
    "ApiKey": "",
    // The test sender of Resend, which needs no verified domain. If Resend refuses it for the recipient, put an address
    // of a verified domain here.
    "SenderEmail": "onboarding@resend.dev",
    // The test recipient of Resend: it accepts each email and delivers to no inbox. Each send counts toward the quota.
    "Recipient": "delivered@resend.dev"
  }
}

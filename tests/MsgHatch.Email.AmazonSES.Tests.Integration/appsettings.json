{
  // The SES account of the integration tests. Never put real values into this file: put them into
  // appsettings.Local.json next to it, which git ignores. A test is skipped while a required value is empty.
  "SesIntegration": {
    // Required: the access key of an IAM user with ses:SendEmail and ses:GetAccount.
    "AccessKeyId": "",
    "SecretAccessKey": "",
    // Optional: the session token of temporary credentials.
    "SessionToken": "",
    // Required: the AWS region of the SES account, for example eu-west-1.
    "Region": "",
    // Required: a verified identity of the SES account, for example noreply@example.com.
    "SenderEmail": "",
    // The SES mailbox simulator accepts each email, also in the SES sandbox, and delivers to no inbox. AWS bills each send.
    "Recipient": "success@simulator.amazonses.com",
    // Optional: another endpoint, for example a local SES emulator.
    "ServiceUrl": ""
  }
}

{
  // The SQL Server of the EF Core integration tests (D180). Never put a password into this file: put the connection
  // string into appsettings.Local.json next to it, which git ignores. With an empty value, the tests start SQL Server
  // in a container with Testcontainers.
  "SqlServerIntegration": {
    // Optional: a connection string to the server with no database, for example to the local container dev-mssql:
    // "Server=localhost,1433;User ID=sa;Password=...;Encrypt=True;TrustServerCertificate=True". The tests create and
    // drop only the databases whose names start with the name of the test project, with each "." as "_".
    "ConnectionString": ""
  },
  // The PostgreSQL of the EF Core integration tests (D180). Never put a password into this file: put the connection
  // string into appsettings.Local.json next to it. With an empty value, the tests start PostgreSQL 18.7 in a container
  // with Testcontainers.
  "PostgreSqlIntegration": {
    // Optional: a connection string to the server, for example to a local PostgreSQL:
    // "Host=localhost;Port=5432;Username=postgres;Password=...". The user needs the right to create databases, and the
    // server needs the database "postgres". The tests create and drop only the databases whose names start with the
    // name of the test project in lower case, with no ".Tests.Integration", with each "." as "_", and then "__".
    "ConnectionString": ""
  }
}

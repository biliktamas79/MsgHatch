{
  // The AWS resources of the integration tests. Never put real values into this file: put them into
  // appsettings.Local.json next to it, which git ignores. A test is skipped while a required value is empty.
  // The tests create no AWS resource: the owner creates the topic, the queue, and the subscription.
  "SnsIntegration": {
    // Required: the access key of an IAM user with sns:Publish and sns:GetTopicAttributes on the topic, and
    // sqs:ReceiveMessage and sqs:DeleteMessage on the queue.
    "AccessKeyId": "",
    "SecretAccessKey": "",
    // Optional: the session token of temporary credentials.
    "SessionToken": "",
    // Required: the AWS region of the topic and the queue, for example eu-west-1.
    "Region": "",
    // Required: the ARN of a standard SNS topic, for example arn:aws:sns:eu-west-1:123456789012:msghatch-tests.
    "TopicArn": "",
    // Required: the URL of an SQS queue with a subscription to the topic with raw message delivery, for example
    // https://sqs.eu-west-1.amazonaws.com/123456789012/msghatch-tests. The tests delete each message that they receive.
    "QueueUrl": ""
  }
}

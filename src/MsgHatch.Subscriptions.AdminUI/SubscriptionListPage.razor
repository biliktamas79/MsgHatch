@attribute [Route(SubscriptionAdminRoutes.List)]
@inject IServiceProvider Services
@inject NavigationManager Navigation
@* The subscriptions, with filters for the owner level, the message type, the kind, the channel, and the mandatory flag (D239), which apply at each change, and the dialog of a new subscription (D260). *@

<AdminListPage Title="Subscriptions">
<Links>
    <a class="btn btn-link btn-sm" href="@SubscriptionAdminRoutes.Verification.TrimStart('/')">Routing verification</a>
</Links>
<Actions>
    <button type="button" class="btn btn-sm btn-primary" data-action="new" @onclick="() => _newOpen = true">+ New subscription</button>
</Actions>
<Filters>
    <div>
        <label class="form-label small mb-1" for="msghatch-subscription-level">Owner level</label>
        <select id="msghatch-subscription-level" class="form-select form-select-sm" @bind="_levelFilter" @bind:after="LoadAsync">
            <option value="">All</option>
            @foreach (var level in Enum.GetValues<SubscriptionLevel>())
            {
                <option value="@level">@level</option>
            }
        </select>
    </div>
    <div>
        <label class="form-label small mb-1" for="msghatch-subscription-type">Message type</label>
        <select id="msghatch-subscription-type" class="form-select form-select-sm" @bind="_typeFilter" @bind:after="LoadAsync">
            <option value="">All</option>
            @foreach (var type in _types)
            {
                <option value="@type">@type</option>
            }
        </select>
    </div>
    <div>
        <label class="form-label small mb-1" for="msghatch-subscription-kind">Kind</label>
        <select id="msghatch-subscription-kind" class="form-select form-select-sm" @bind="_kindFilter" @bind:after="LoadAsync">
            <option value="">All</option>
            @foreach (var kind in Enum.GetValues<SubscriptionKind>())
            {
                <option value="@kind">@kind</option>
            }
        </select>
    </div>
    <div>
        <label class="form-label small mb-1" for="msghatch-subscription-channel">Channel</label>
        <select id="msghatch-subscription-channel" class="form-select form-select-sm" @bind="_channelFilter" @bind:after="LoadAsync">
            <option value="">All</option>
            @foreach (var channel in _channels)
            {
                <option value="@channel">@channel</option>
            }
        </select>
    </div>
    <div>
        <label class="form-label small mb-1" for="msghatch-subscription-mandatory">Mandatory</label>
        <select id="msghatch-subscription-mandatory" class="form-select form-select-sm" @bind="_mandatoryFilter" @bind:after="LoadAsync">
            <option value="">All</option>
            <option value="Yes">Yes</option>
            <option value="No">No</option>
        </select>
    </div>
</Filters>
<ChildContent>
<ErrorAlert Error="_deleteError" />
<AdminList TItem="Subscription" Items="_subscriptions" EmptyText="There are no subscriptions.">
    <Head>
        <tr><th>Owner</th><th>Message type</th><th>Kind</th><th>Channel</th><th>Recipients</th><th>Mandatory</th><th>Revision</th><th></th></tr>
    </Head>
    <Row Context="subscription">
        <tr data-row>
            <td>@SubscriptionTexts.OwnerOf(subscription.Owner)</td>
            <td>@subscription.Type.Name</td>
            <td>@subscription.Kind</td>
            <td>@(subscription.Channel?.Name ?? "All channels")</td>
            <td>@SubscriptionTexts.RecipientsOf(subscription.Recipients)</td>
            <td>@(subscription.Mandatory ? "Yes" : "No")</td>
            <td>@subscription.Revision</td>
            <td class="text-end text-nowrap">
                <a class="btn btn-sm btn-outline-primary" data-action="edit" href="@SubscriptionAdminRoutes.Edit(subscription.Id).TrimStart('/')">Edit</a>
                <button type="button" class="btn btn-sm btn-outline-danger" data-action="delete" @onclick="() => _deleting = subscription">Delete</button>
            </td>
        </tr>
    </Row>
</AdminList>
</ChildContent>
</AdminListPage>

<AdminDialog Open="_newOpen" Title="New subscription" Wide="true">
    <SubscriptionEditor Cancelled="CloseNewAsync" Created="OnCreatedAsync" />
</AdminDialog>

<DeleteDialog Open="_deleting is not null" Question="Do you want to delete this subscription?" Confirmed="DeleteAsync" Cancelled="() => _deleting = null">
    <Details>
        @if (_deleting is { } stored)
        {
            <SubscriptionDeleteDetails Subscription="stored" />
        }
    </Details>
</DeleteDialog>

@code {
    private bool _newOpen;
    private Subscription? _deleting;
    private Error? _deleteError;
    private ErrorOr<IReadOnlyList<Subscription>>? _subscriptions;
    private IReadOnlyList<string> _types = [];
    private IReadOnlyList<string> _channels = [];
    private string _levelFilter = string.Empty;
    private string _typeFilter = string.Empty;
    private string _channelFilter = string.Empty;
    private string _kindFilter = string.Empty;
    private string _mandatoryFilter = string.Empty;
    private int _lastLoad;

    /// <summary>True from the query <c>new=true</c> of <see cref="SubscriptionAdminRoutes.New"/>, which opens the dialog of a new subscription.</summary>
    [SupplyParameterFromQuery(Name = "new")]
    public bool? New { get; set; }

    /// <summary>The message type filter from the query <c>type</c> of <see cref="SubscriptionAdminRoutes.ListOf"/> (D276).</summary>
    [SupplyParameterFromQuery(Name = "type")]
    public string? Type { get; set; }

    /// <summary>The level filter from the query <c>level</c> of <see cref="SubscriptionAdminRoutes.ListOf"/> (D276).</summary>
    [SupplyParameterFromQuery(Name = "level")]
    public string? Level { get; set; }

    private ISubscriptionQueries Queries => Services.GetRequiredKeyedService<ISubscriptionQueries>(TenantKey.None);

    private ISubscriptionCommands Commands => Services.GetRequiredKeyedService<ISubscriptionCommands>(TenantKey.None);

    /// <inheritdoc />
    protected override async Task OnInitializedAsync()
    {
        _newOpen = New == true;
        StartWithTheFiltersOfTheAddress();
        var types = await Queries.GetMessageTypesAsync(new MessageTypeQuery(), CancellationToken.None);
        var channels = await Queries.GetChannelsAsync(CancellationToken.None);
        _types = types.IsSuccess ? [.. types.Value.Select(static state => state.Type.Name)] : [];
        _channels = channels.IsSuccess ? [.. channels.Value.Select(static channel => channel.Id.Name)] : [];
        await LoadAsync();
    }

    private Task CloseNewAsync()
    {
        _newOpen = false;
        if (New == true)
        {
            Navigation.NavigateTo(SubscriptionAdminRoutes.List.TrimStart('/'), replace: true);
        }

        return Task.CompletedTask;
    }

    private async Task OnCreatedAsync(Subscription created)
    {
        await CloseNewAsync();
        await LoadAsync();
    }

    private async Task DeleteAsync()
    {
        if (_deleting is not { } subscription)
        {
            return;
        }

        _deleting = null;
        _deleteError = await Commands.DeleteAsync(subscription.Id, CancellationToken.None);
        if (_deleteError is null)
        {
            await LoadAsync();
        }
    }

    private async Task LoadAsync()
    {
        var load = ++_lastLoad;
        _subscriptions = null;
        MessageType? type = null;
        if (_typeFilter.Length > 0)
        {
            var parsed = SubscriptionTexts.MessageTypeOf(_typeFilter);
            if (parsed.IsError)
            {
                _subscriptions = parsed.Error;
                return;
            }

            type = parsed.Value;
        }

        SubscriptionLevel? level = Enum.TryParse<SubscriptionLevel>(_levelFilter, out var known) && Enum.IsDefined(known) ? known : null;
        var found = await Queries.GetSubscriptionsAsync(new SubscriptionQuery(Type: type, Level: level), CancellationToken.None);
        if (load != _lastLoad)
        {
            return;
        }

        _subscriptions = found.IsError ? found : ErrorOr<IReadOnlyList<Subscription>>.ForValue([.. found.Value.Where(MatchesTheListFilters)]);
    }

    /// <summary>Starts with the filters of the query <c>type</c> and <c>level</c>. A value that is not valid gives no filter for that value.</summary>
    private void StartWithTheFiltersOfTheAddress()
    {
        if (Type is { } type && SubscriptionTexts.MessageTypeOf(type) is { IsSuccess: true } parsed)
        {
            _typeFilter = parsed.Value.Name;
        }

        if (Level is { } level && Enum.GetNames<SubscriptionLevel>().Contains(level, StringComparer.Ordinal))
        {
            _levelFilter = level;
        }
    }

    private bool MatchesTheListFilters(Subscription subscription) =>
        (_channelFilter.Length == 0 || subscription.Channel?.Name == _channelFilter)
        && (_kindFilter.Length == 0 || string.Equals(subscription.Kind.ToString(), _kindFilter, StringComparison.Ordinal))
        && (_mandatoryFilter.Length == 0 || subscription.Mandatory == (_mandatoryFilter == "Yes"));
}

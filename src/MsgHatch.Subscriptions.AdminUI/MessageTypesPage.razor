@attribute [Route(SubscriptionAdminRoutes.MessageTypes)]
@inject IServiceProvider Services
@* The applied subscriptions of each message type: the channels and the applied subscriptions of a scope (D239, D273). *@

<AdminListPage Title="Applied subscriptions">
<Links>
    <a class="btn btn-link btn-sm" href="@SubscriptionAdminRoutes.List.TrimStart('/')">Back to the subscriptions</a>
</Links>
<Filters>
    <div>
        <label class="form-label small mb-1" for="msghatch-types-company">Company id</label>
        <input id="msghatch-types-company" class="form-control form-control-sm" @bind="_company" />
    </div>
    <div>
        <label class="form-label small mb-1" for="msghatch-types-user">User id</label>
        <input id="msghatch-types-user" class="form-control form-control-sm" @bind="_user" />
    </div>
    <div>
        <button type="button" class="btn btn-sm btn-secondary" data-action="filter" @onclick="LoadAsync">Show</button>
    </div>
</Filters>
<ChildContent>
<AdminList TItem="MessageTypeState" Items="_states" EmptyText="There are no message types.">
    <Head>
        <tr><th>Message type</th><th>Channels</th><th>Applied subscriptions</th></tr>
    </Head>
    <Row Context="state">
        <tr data-row>
            <td>@state.Type.Name</td>
            <td>@(state.Channels.Count == 0 ? "None" : string.Join(", ", state.Channels.Select(static channel => channel.Name)))</td>
            <td>@state.AppliedSubscriptions.Count</td>
        </tr>
    </Row>
</AdminList>
</ChildContent>
</AdminListPage>

@code {
    private ErrorOr<IReadOnlyList<MessageTypeState>>? _states;
    private string _company = string.Empty;
    private string _user = string.Empty;

    private ISubscriptionQueries Queries => Services.GetRequiredKeyedService<ISubscriptionQueries>(TenantKey.None);

    /// <inheritdoc />
    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        _states = null;
        var company = SubscriptionTexts.OptionalOf(_company) is { } companyText ? CompanyId.Create(companyText) : (ErrorOr<CompanyId>?)null;
        var user = SubscriptionTexts.OptionalOf(_user) is { } userText ? UserId.Create(userText) : (ErrorOr<UserId>?)null;
        if ((company?.Error ?? user?.Error) is { } error)
        {
            _states = error;
            return;
        }

        _states = await Queries.GetMessageTypesAsync(new MessageTypeQuery(Company: company?.Value, User: user?.Value), CancellationToken.None);
    }
}

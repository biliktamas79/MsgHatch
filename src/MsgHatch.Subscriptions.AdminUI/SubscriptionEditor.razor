@inject IServiceProvider Services
@inject IContentTypeRegistry Registry
@inject NavigationManager Navigation
@* The form of one subscription, with a create, an update, and a delete after a question (D239, D260). The settings are JSON text (D229). The edit page shows it for a stored subscription, and the list shows it in the dialog of a new subscription. *@

<AdminEditPage>
    <Header>
        @if (Title is not null)
        {
            <h1 class="h3">@Title</h1>
        }
    </Header>
    <ChildContent>
        @if (_loadError is not null)
        {
            <ErrorAlert Error="_loadError" />
        }
        else if (_form is not { } form)
        {
            <p class="text-secondary" role="status" data-state="loading">Loading.</p>
        }
        else
        {
            @if (Id is not null)
            {
                <p class="text-secondary">Revision <span data-field="revision">@_revision</span></p>
            }

            <div class="row g-3" data-form="subscription">
                <div class="col-md-4">
                    <label class="form-label" for="msghatch-edit-level">Owner level</label>
                    <select id="msghatch-edit-level" class="form-select @ChangedClass(static draft => draft.Level)" @bind="form.Level">
                        @foreach (var level in Enum.GetValues<SubscriptionLevel>())
                        {
                            <option value="@level">@level</option>
                        }
                    </select>
                </div>
                @if (form.Level == SubscriptionLevel.Company)
                {
                    <div class="col-md-4">
                        <label class="form-label" for="msghatch-edit-company">Company id</label>
                        <input id="msghatch-edit-company" class="form-control @ChangedClass(static draft => draft.CompanyId)" @bind="form.CompanyId" />
                    </div>
                }
                @if (form.Level == SubscriptionLevel.User)
                {
                    <div class="col-md-4">
                        <label class="form-label" for="msghatch-edit-user">User id</label>
                        <input id="msghatch-edit-user" class="form-control @ChangedClass(static draft => draft.UserId)" @bind="form.UserId" />
                    </div>
                }
                <div class="col-md-4">
                    <label class="form-label" for="msghatch-edit-type">Message type</label>
                    <select id="msghatch-edit-type" class="form-select @ChangedClass(static draft => draft.MessageType)" @bind="form.MessageType" @bind:after="() => KeepARegisteredChannel(form)">
                        @foreach (var type in TypeOptions(form))
                        {
                            <option value="@type">@type</option>
                        }
                    </select>
                </div>
                <div class="col-md-4">
                    <label class="form-label" for="msghatch-edit-kind">Kind</label>
                    <select id="msghatch-edit-kind" class="form-select @ChangedClass(static draft => draft.Kind)" @bind="form.Kind">
                        @foreach (var kind in Enum.GetValues<SubscriptionKind>())
                        {
                            <option value="@kind">@kind</option>
                        }
                    </select>
                </div>
                <div class="col-md-4">
                    <label class="form-label" for="msghatch-edit-channel">Channel</label>
                    <select id="msghatch-edit-channel" class="form-select @ChangedClass(static draft => draft.Channel)" @bind="form.Channel">
                        <option value="">None</option>
                        @foreach (var channel in ChannelOptions(form))
                        {
                            <option value="@channel.Id.Name">@channel.Name</option>
                        }
                    </select>
                </div>
                <div class="col-12">
                    <label class="form-label" for="msghatch-edit-settings">Settings (JSON)</label>
                    <textarea id="msghatch-edit-settings" class="form-control font-monospace @ChangedClass(static draft => draft.Settings)" rows="6" spellcheck="false" disabled="@(form.Kind == SubscriptionKind.OptOut)" @bind="form.Settings"></textarea>
                    <div class="form-text" data-field="settings-type">@SettingsTypeText(form)</div>
                </div>
                <div class="col-md-4">
                    <label class="form-label" for="msghatch-edit-recipients">Recipients</label>
                    <select id="msghatch-edit-recipients" class="form-select @ChangedClass(static draft => draft.Recipients)" @bind="form.Recipients">
                        @foreach (var recipients in Enum.GetValues<RecipientKind>())
                        {
                            <option value="@recipients">@recipients</option>
                        }
                    </select>
                </div>
                @if (form.Recipients == RecipientKind.NamedUsers)
                {
                    <div class="col-md-8">
                        <label class="form-label" for="msghatch-edit-users">Named users, one user id on each line</label>
                        <textarea id="msghatch-edit-users" class="form-control @ChangedClass(static draft => draft.Users)" rows="4" @bind="form.Users"></textarea>
                    </div>
                }
                <div class="col-12 mt-1">
                    <div class="form-text mt-0" data-field="recipients-help">@RecipientsText(form.Recipients)</div>
                </div>
                <div class="col-12">
                    <div class="form-check">
                        <input id="msghatch-edit-mandatory" class="form-check-input @ChangedClass(static draft => draft.Mandatory)" type="checkbox" @bind="form.Mandatory" />
                        <label class="form-check-label" for="msghatch-edit-mandatory">Mandatory</label>
                    </div>
                </div>
            </div>


            <DeleteDialog Open="_confirmDelete" Question="Do you want to delete this subscription?" Confirmed="DeleteAsync" Cancelled="() => _confirmDelete = false">
                <Details>
                    @if (_subscription is { } stored)
                    {
                        <SubscriptionDeleteDetails Subscription="stored" />
                    }
                </Details>
            </DeleteDialog>
        }
    </ChildContent>
    <Actions>
        <AdminActions>
            <Start>
                @if (Cancelled.HasDelegate)
                {
                    <button type="button" class="btn btn-outline-secondary" data-action="cancel" @onclick="() => Cancelled.InvokeAsync()">Cancel</button>
                }
                else
                {
                    <a class="btn btn-outline-secondary" data-action="back" href="@SubscriptionAdminRoutes.List.TrimStart('/')">Back to the subscriptions</a>
                }
            </Start>
            <Middle>
                <ErrorAlert Error="_formError" Text="@CreateConflictText(_formError)" Class="mb-0 py-1 px-2" />
                @if (_loadError is null && _form is { } form && _stored is not null && form.ChangesFrom(_stored) is { Count: > 0 } changes)
                {
                    <p class="text-warning mb-0" data-state="pending">Changes that are not saved: @string.Join(", ", changes).</p>
                }
                @if (_saved && _loadError is null && _form is not null)
                {
                    <div class="alert alert-success mb-0 py-1 px-2" role="status" data-state="saved">The subscription is saved.</div>
                }
            </Middle>
            <End>
                @if (_loadError is null && _form is not null)
                {
                    if (Id is not null)
                    {
                        <button type="button" class="btn btn-outline-danger" data-action="delete" disabled="@_busy" @onclick="() => _confirmDelete = true">Delete</button>
                    }
                    <button type="button" class="btn btn-primary" data-action="save" disabled="@_busy" @onclick="SaveAsync">@(Id is null ? "Create" : "Save")</button>
                }
            </End>
        </AdminActions>
    </Actions>
</AdminEditPage>

@code {
    private SubscriptionForm? _form;
    private SubscriptionForm? _stored;
    private Subscription? _subscription;
    private int _revision;
    private IReadOnlyList<ChannelDescriptor> _channels = [];
    private IReadOnlyList<string> _types = [];
    private Dictionary<string, IReadOnlyList<ChannelId>> _typeChannels = [];
    private Error? _loadError;
    private Error? _formError;
    private bool _busy;
    private bool _saved;
    private bool _confirmDelete;

    /// <summary>The title over the form, for example on the edit page, or null for no title, for example in a dialog.</summary>
    [Parameter]
    public string? Title { get; set; }

    /// <summary>The id of the stored subscription, or null for a new subscription.</summary>
    [Parameter]
    public Guid? Id { get; set; }

    /// <summary>
    /// Runs when the user cancels, for example in a dialog. With no handler, the editor shows a link back to the subscriptions in
    /// place of Cancel.
    /// </summary>
    [Parameter]
    public EventCallback Cancelled { get; set; }

    /// <summary>Gets the subscription after a create. With no handler, the editor opens the edit page of the new subscription.</summary>
    [Parameter]
    public EventCallback<Subscription> Created { get; set; }

    private ISubscriptionQueries Queries => Services.GetRequiredKeyedService<ISubscriptionQueries>(TenantKey.None);

    private ISubscriptionCommands Commands => Services.GetRequiredKeyedService<ISubscriptionCommands>(TenantKey.None);

    /// <inheritdoc />
    protected override async Task OnParametersSetAsync()
    {
        (_form, _stored, _loadError, _formError, _saved) = (null, null, null, null, false);
        var channels = await Queries.GetChannelsAsync(CancellationToken.None);
        var types = await Queries.GetMessageTypesAsync(new MessageTypeQuery(), CancellationToken.None);
        _loadError = channels.Error ?? types.Error;
        if (_loadError is not null)
        {
            return;
        }

        _channels = channels.Value;
        _types = [.. types.Value.Select(static state => state.Type.Name)];
        _typeChannels = types.Value.ToDictionary(static state => state.Type.Name, static state => state.Channels);
        _loadError = Id is { } id ? await LoadAsync(id) : null;
        _form ??= NewForm();
    }

    private async Task<Error?> LoadAsync(Guid id)
    {
        var subscription = await Queries.GetSubscriptionAsync(id, CancellationToken.None);
        if (subscription.IsError)
        {
            return subscription.Error;
        }

        Show(subscription.Value);
        return null;
    }

    private void Show(Subscription subscription)
    {
        _form = SubscriptionForm.From(subscription, Registry);
        _stored = _form with { };
        _subscription = subscription;
        _revision = subscription.Revision;
    }

    private SubscriptionForm NewForm()
    {
        var type = _types.FirstOrDefault() ?? string.Empty;
        var channel = FirstChannelOf(type);
        return new() { MessageType = type, Channel = channel, Settings = channel.Length > 0 ? "{}" : string.Empty };
    }

    private async Task SaveAsync()
    {
        if (_form is not { } form)
        {
            return;
        }

        (_saved, _formError) = (false, null);
        var draft = form.ToDraft(_channels, Registry);
        if (draft.IsError)
        {
            _formError = draft.Error;
            return;
        }

        _busy = true;
        try
        {
            if (Id is { } id)
            {
                await UpdateAsync(id, draft.Value);
                return;
            }

            var created = await Commands.CreateAsync(draft.Value, CancellationToken.None);
            if (created.IsError)
            {
                _formError = created.Error;
                return;
            }

            if (Created.HasDelegate)
            {
                await Created.InvokeAsync(created.Value);
                return;
            }

            Navigation.NavigateTo(SubscriptionAdminRoutes.Edit(created.Value.Id).TrimStart('/'));
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task UpdateAsync(Guid id, SubscriptionDraft draft)
    {
        var updated = await Commands.UpdateAsync(id, _revision, draft, CancellationToken.None);
        if (updated.IsError)
        {
            _formError = updated.Error.Type == Errors.Conflict ? await LoadAsync(id) ?? updated.Error : updated.Error;
            return;
        }

        Show(updated.Value);
        _saved = true;
    }

    private async Task DeleteAsync()
    {
        _confirmDelete = false;
        if (Id is not { } id)
        {
            return;
        }

        _busy = true;
        _formError = await Commands.DeleteAsync(id, CancellationToken.None);
        _busy = false;
        if (_formError is null)
        {
            Navigation.NavigateTo(SubscriptionAdminRoutes.List.TrimStart('/'));
        }
    }

    /// <summary>
    /// Gives the message of a <see cref="Errors.Conflict"/> of a create, for example that the owner already has a subscription
    /// for the message type, the channel, and the recipient kind. A create loads no stored version, so the fixed text of
    /// <see cref="AdminErrors.ConflictText"/> does not apply.
    /// </summary>
    /// <summary>The yellow border of a field whose value is not the stored value, or null for a field with no change.</summary>
    private string? ChangedClass(Func<SubscriptionForm, object?> field) =>
        _form is { } form && _stored is { } stored && !Equals(field(form), field(stored)) ? "border-warning" : null;

    private string? CreateConflictText(Error? error) => Id is null && error?.Type == Errors.Conflict ? error.Message : null;

    private IEnumerable<string> TypeOptions(SubscriptionForm form) =>
        form.MessageType.Length == 0 || _types.Contains(form.MessageType) ? _types : [form.MessageType, .. _types];

    private IEnumerable<ChannelDescriptor> ChannelOptions(SubscriptionForm form) =>
        _channels.Where(channel => channel.Id.Name == form.Channel || IsRegistered(form.MessageType, channel.Id));

    private bool IsRegistered(string type, ChannelId channel) => _typeChannels.TryGetValue(type, out var channels) && channels.Contains(channel);

    private string FirstChannelOf(string type) => _channels.FirstOrDefault(channel => IsRegistered(type, channel.Id))?.Id.Name ?? string.Empty;

    private void KeepARegisteredChannel(SubscriptionForm form)
    {
        if (form.Channel.Length > 0 && !_channels.Any(channel => channel.Id.Name == form.Channel && IsRegistered(form.MessageType, channel.Id)))
        {
            form.Channel = FirstChannelOf(form.MessageType);
        }
    }

    private string SettingsTypeText(SubscriptionForm form) =>
        form.Kind == SubscriptionKind.OptOut ? "An opt-out has no settings, so the save sends none."
        : _channels.FirstOrDefault(channel => channel.Id.Name == form.Channel) is not { } channel ? "A subscription with no channel has no settings."
        : channel.SettingsType == typeof(ChannelSettings) ? "This host has no settings type for the channel, so it sends the JSON with no change."
        : $"This host reads the settings as {channel.SettingsType.Name}.";

    private static string RecipientsText(RecipientKind recipients) => recipients switch
    {
        RecipientKind.Company =>
            "One message goes to the address of the company that the event concerns, for example a shared mailbox. "
            + "The recipient directory gives this address. The users of the company get no message. No lower level overrides it.",
        RecipientKind.NamedUsers =>
            "Each named user gets the message. A company subscription sends only to the named users of that company. "
            + "No lower level overrides it.",
        _ =>
            "Each user that the owner covers gets the message: all users of the event for the default level, the users "
            + "of the company for the company level, or the user. For an event of a company, a channel with group delivery, "
            + "for example SignalR, sends one message to the group of the company.",
    };
}

@inherits TemplateEditorBase
@implements IAsyncDisposable
@* The editor of a Liquid text (D242): a text area over a highlighted copy of the text, with the marks of the issues. *@

<div class="liquid-editor" data-editor="liquid">
    <pre class="liquid-layer form-control" aria-hidden="true" @ref="_layer">@foreach (var segment in LiquidSegments.Of(Text, MarkedOffsets()))
        {
            if (segment.Mark is { } mark)
            {
                <mark class="liquid-issue @segment.CssClass" data-mark="@mark">@Text.Substring(segment.Start, segment.Length)</mark>
            }
            else
            {
                <span class="@segment.CssClass">@Text.Substring(segment.Start, segment.Length)</span>
            }
        }@("\n")</pre>
    <textarea class="liquid-input form-control @(AllIssues().Count > 0 ? "is-invalid" : null)" spellcheck="false" aria-label="Template text" @ref="_input"
              value="@Text" disabled="@Disabled" @oninput="OnInputAsync"></textarea>
</div>
@foreach (var issue in AllIssues())
{
    <div class="invalid-feedback d-block" data-issue>@TextOf(issue)</div>
}
@if (_checkError is not null)
{
    <div class="form-text text-warning" data-state="check-failed">The check did not run. @AdminErrors.TextOf(_checkError)</div>
}

@code {
    /// <summary>The name of the Liquid engine, which equals the name of <c>LiquidTemplates.Engine</c> (D240).</summary>
    public const string EngineName = "liquid";

    private static readonly TimeSpan _pause = TimeSpan.FromMilliseconds(500);
    private ElementReference _layer;
    private ElementReference _input;
    private IJSObjectReference? _module;
    private CancellationTokenSource? _pending;
    private IReadOnlyList<TemplateIssue> _checkIssues = [];
    private Error? _checkError;

    [Inject]
    private TimeProvider Clock { get; set; } = default!;

    [Inject]
    private IJSRuntime JS { get; set; } = default!;

    /// <summary>Checks the text now with the server, and gives false when the text has an issue (D241, D242).</summary>
    /// <param name="ct">The cancellation token.</param>
    /// <returns>True when the page can save the text, also when the check did not run, so that the save gives its error.</returns>
    public override async ValueTask<bool> CanSaveAsync(CancellationToken ct)
    {
        using var linked = CancellationTokenSource.CreateLinkedTokenSource(ct, Restart().Token);
        var passed = await CheckNowAsync(Text, linked.Token);
        StateHasChanged();
        return passed;
    }

    /// <inheritdoc />
    public async ValueTask DisposeAsync()
    {
        _pending?.Cancel();
        _pending?.Dispose();
        if (_module is not null)
        {
            try
            {
                await _module.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
            }
        }
    }

    /// <inheritdoc />
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _module = await JS.InvokeAsync<IJSObjectReference>("import", "./_content/MsgHatch.Templates.Liquid.AdminUI/liquidEditor.js");
            if (_module is not null)
            {
                await _module.InvokeVoidAsync("syncScroll", _input, _layer);
            }
        }
    }

    private async Task OnInputAsync(ChangeEventArgs args)
    {
        var text = args.Value as string ?? string.Empty;
        (_checkIssues, _checkError) = ([], null);
        var pending = Restart();
        await TextChanged.InvokeAsync(text);
        try
        {
            await Task.Delay(_pause, Clock, pending.Token);
        }
        catch (OperationCanceledException)
        {
            return;
        }

        await CheckNowAsync(text, pending.Token);
    }

    private async Task<bool> CheckNowAsync(string text, CancellationToken ct)
    {
        var issues = await CheckAsync(text, ct);
        if (ct.IsCancellationRequested)
        {
            return false;
        }

        if (issues.IsError)
        {
            (_checkIssues, _checkError) = ([], issues.Error);
            return true;
        }

        (_checkIssues, _checkError) = (issues.Value, null);
        return issues.Value.Count == 0;
    }

    private CancellationTokenSource Restart()
    {
        _pending?.Cancel();
        _pending?.Dispose();
        _pending = new CancellationTokenSource();
        return _pending;
    }

    private List<TemplateIssue> AllIssues() => [.. LiquidTokenizer.FindIssues(Text), .. _checkIssues, .. Issues];

    private Dictionary<int, string> MarkedOffsets()
    {
        var marks = new Dictionary<int, string>();
        foreach (var issue in AllIssues())
        {
            if (issue is { Line: { } line, Column: { } column } && LiquidTokenizer.OffsetOf(Text, line, column) is { } offset)
            {
                marks.TryAdd(offset, $"{line}:{column}");
            }
        }

        return marks;
    }
}

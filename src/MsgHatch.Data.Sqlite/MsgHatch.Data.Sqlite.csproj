<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Description>The SQLite stores of MsgHatch: the inbox, the outbox, and the registry settings in one database file.</Description>
    <PackageTags>messaging;outbox;inbox;sqlite</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\MsgHatch.Domain\MsgHatch.Domain.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\Shared\FileNames.cs" Link="Shared\FileNames.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="MsgHatch.Subscriptions.Data.Sqlite" />
  </ItemGroup>

</Project>

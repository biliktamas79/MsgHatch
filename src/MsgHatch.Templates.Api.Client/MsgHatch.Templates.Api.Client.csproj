<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Description>The HTTP client of the MsgHatch template management API: ITemplateQueries and ITemplateCommands over HTTP.</Description>
    <PackageTags>messaging;templates;api;http-client</PackageTags>
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\MsgHatch.Templates.Api.Contracts\MsgHatch.Templates.Api.Contracts.csproj" />
    <ProjectReference Include="..\MsgHatch.SourceGeneration\MsgHatch.SourceGeneration.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Http" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\Shared\ErrorProblems.cs" Link="Shared\ErrorProblems.cs" />
    <Compile Include="..\Shared\TemplateApiRoutes.cs" Link="Shared\TemplateApiRoutes.cs" />
    <Compile Include="..\Shared\ApiResults.cs" Link="Shared\ApiResults.cs" />
  </ItemGroup>

</Project>

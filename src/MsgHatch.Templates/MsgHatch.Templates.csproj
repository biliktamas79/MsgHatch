<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Description>The MsgHatch template library, which knows no channel: the template engine contract, the file template store, the template selector, and the placeholder engine.</Description>
    <PackageTags>messaging;templates;placeholders</PackageTags>
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\MsgHatch.Domain\MsgHatch.Domain.csproj" />
    <ProjectReference Include="..\MsgHatch.SourceGeneration\MsgHatch.SourceGeneration.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\Shared\FileNames.cs" Link="Shared\FileNames.cs" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\MsgHatch.SourceGeneration\bin\$(Configuration)\netstandard2.0\MsgHatch.SourceGeneration.dll" Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" />
  </ItemGroup>

</Project>

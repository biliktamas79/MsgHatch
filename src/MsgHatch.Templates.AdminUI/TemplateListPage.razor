@attribute [Route(TemplateAdminRoutes.List)]
@inject IServiceProvider Services
@inject NavigationManager Navigation
@inject TimeProvider Clock
@* The template list, with filters for the message type, the language, the company, the part, and the kind, which apply at each change, a text filter after a pause of 500 ms, and a dialog of a new template from the declared parts (D240, D260). *@

<AdminListPage Title="Templates">
<Actions>
    <button type="button" class="btn btn-sm btn-primary" data-action="new" @onclick="OpenNewDialog">+ New template</button>
</Actions>
<Filters>
    <div>
        <label class="form-label small mb-1" for="msghatch-template-type">Message type</label>
        <select id="msghatch-template-type" class="form-select form-select-sm" @bind="_typeFilter" @bind:after="LoadEntriesAsync">
            <option value="">All</option>
            @foreach (var type in TypesOf(_parts))
            {
                <option value="@type">@type</option>
            }
        </select>
    </div>
    <div>
        <label class="form-label small mb-1" for="msghatch-template-language-filter">Language</label>
        <input id="msghatch-template-language-filter" class="form-control form-control-sm" @bind="_languageFilter" @bind:event="oninput" @bind:after="LoadAfterAPauseAsync" />
    </div>
    <div>
        <label class="form-label small mb-1" for="msghatch-template-company">Company id</label>
        <input id="msghatch-template-company" class="form-control form-control-sm" @bind="_companyFilter" @bind:event="oninput" @bind:after="LoadAfterAPauseAsync" />
    </div>
    <div>
        <label class="form-label small mb-1" for="msghatch-template-part-filter">Part</label>
        <select id="msghatch-template-part-filter" class="form-select form-select-sm" @bind="_partFilter" @bind:after="LoadEntriesAsync">
            <option value="">All</option>
            @foreach (var part in PartNamesOf(_parts))
            {
                <option value="@part">@part</option>
            }
        </select>
    </div>
    <div>
        <label class="form-label small mb-1" for="msghatch-template-kind">Kind</label>
        <select id="msghatch-template-kind" class="form-select form-select-sm" @bind="_kindFilter" @bind:after="LoadEntriesAsync">
            <option value="">All</option>
            @foreach (var kind in Enum.GetValues<TemplatePartKind>())
            {
                <option value="@kind">@kind</option>
            }
        </select>
    </div>
</Filters>
<ChildContent>
<ErrorAlert Error="_deleteError" />
<AdminList TItem="TemplateEntry" Items="_entries" EmptyText="There are no templates.">
    <Head>
        <tr><th>Message type</th><th>Language</th><th>Company</th><th>Part</th><th>Kind</th><th>Version</th><th></th></tr>
    </Head>
    <Row Context="entry">
        <tr data-row>
            <td>@entry.Lookup.Type.Name</td>
            <td>@entry.Lookup.Language</td>
            <td>@(entry.Lookup.Scope ?? "All companies")</td>
            <td>@entry.Lookup.Part</td>
            <td>@entry.Lookup.Kind</td>
            <td>@VersionTexts.Of(entry.Version, entry.VersionText)</td>
            <td class="text-end text-nowrap">
                <a class="btn btn-sm btn-outline-secondary" data-action="view" href="@TemplateAdminRoutes.View(entry.Lookup).TrimStart('/')">View</a>
                <a class="btn btn-sm btn-outline-primary" data-action="edit" href="@TemplateAdminRoutes.Edit(entry.Lookup).TrimStart('/')">Edit</a>
                <button type="button" class="btn btn-sm btn-outline-danger" data-action="delete" @onclick="() => _deleting = entry">Delete</button>
            </td>
        </tr>
    </Row>
</AdminList>
</ChildContent>
</AdminListPage>

<DeleteDialog Open="_deleting is not null" Question="@(_deleting is { } asked ? TemplateDeleteDetails.QuestionOf(asked.Lookup) : string.Empty)"
              Confirmed="DeleteAsync" Cancelled="() => _deleting = null">
    <Details>
        @if (_deleting is { } entry)
        {
            <TemplateDeleteDetails Lookup="entry.Lookup" Version="entry.Version" VersionText="@entry.VersionText" />
        }
    </Details>
</DeleteDialog>

<AdminDialog Open="_newOpen" Title="New template">
    <ChildContent>
        @if (_parts is { IsError: true } failed)
        {
            <ErrorAlert Error="failed.Error" />
        }
        else if (_parts is { Value.Count: > 0 } parts)
        {
            <div data-form="new">
                <div class="mb-3">
                    <label class="form-label" for="msghatch-template-part">Part</label>
                    <select id="msghatch-template-part" class="form-select" @bind="_newPart">
                        @for (var index = 0; index < parts.Value.Count; index++)
                        {
                            var part = parts.Value[index];
                            <option value="@index">@part.Type.Name / @part.Part.Name / @part.Part.Kind</option>
                        }
                    </select>
                </div>
                <div class="mb-3">
                    <label class="form-label" for="msghatch-template-language">Language</label>
                    <input id="msghatch-template-language" class="form-control" @bind="_newLanguage" />
                </div>
                <div class="mb-3">
                    <label class="form-label" for="msghatch-template-new-company">Company id</label>
                    <input id="msghatch-template-new-company" class="form-control" @bind="_newCompany" />
                </div>
            </div>
            <ErrorAlert Error="_newError" />
        }
        else
        {
            <p class="text-secondary mb-0" data-state="no-parts">No message type declares a template part.</p>
        }
    </ChildContent>
    <Start>
        <button type="button" class="btn btn-outline-secondary" data-action="cancel-new" @onclick="CloseNewDialog">Cancel</button>
    </Start>
    <End>
        @if (_parts is { IsSuccess: true, Value.Count: > 0 })
        {
            <button type="button" class="btn btn-primary" data-action="open-editor" @onclick="OpenNew">Open the editor</button>
        }
    </End>
</AdminDialog>

@code {
    private static readonly TimeSpan _pause = TimeSpan.FromMilliseconds(500);
    private ErrorOr<IReadOnlyList<TemplatePartInfo>>? _parts;
    private ErrorOr<IReadOnlyList<TemplateEntry>>? _entries;
    private string _typeFilter = string.Empty;
    private string _companyFilter = string.Empty;
    private string _languageFilter = string.Empty;
    private string _partFilter = string.Empty;
    private string _kindFilter = string.Empty;
    private int _lastLoad;
    private string _newPart = "0";
    private string _newLanguage = "en";
    private string _newCompany = string.Empty;
    private Error? _newError;
    private bool _newOpen;
    private TemplateEntry? _deleting;
    private Error? _deleteError;

    private ITemplateQueries Queries => Services.GetRequiredKeyedService<ITemplateQueries>(TenantKey.None);

    private ITemplateCommands Commands => Services.GetRequiredKeyedService<ITemplateCommands>(TenantKey.None);

    /// <inheritdoc />
    protected override async Task OnInitializedAsync()
    {
        _parts = await Queries.GetTemplatePartsAsync(type: null, CancellationToken.None);
        await LoadEntriesAsync();
    }

    private async Task DeleteAsync()
    {
        if (_deleting is not { } entry)
        {
            return;
        }

        _deleting = null;
        _deleteError = await Commands.DeleteTemplateAsync(entry.Lookup, CancellationToken.None);
        if (_deleteError is null)
        {
            await LoadEntriesAsync();
        }
    }

    private async Task LoadEntriesAsync()
    {
        var load = ++_lastLoad;
        _entries = null;
        MessageType? type = null;
        if (_typeFilter.Length > 0)
        {
            var parsed = TemplateRouteValues.TypeOf(_typeFilter);
            if (parsed.IsError)
            {
                _entries = parsed.Error;
                return;
            }

            type = parsed.Value;
        }

        var found = await Queries.GetTemplatesAsync(new TemplateQuery(type, OptionalOf(_companyFilter)), CancellationToken.None);
        if (load != _lastLoad)
        {
            return;
        }

        _entries = found.IsError ? found : ErrorOr<IReadOnlyList<TemplateEntry>>.ForValue([.. found.Value.Where(MatchesTheListFilters)]);
    }

    private async Task LoadAfterAPauseAsync()
    {
        var load = ++_lastLoad;
        await Task.Delay(_pause, Clock);
        if (load == _lastLoad)
        {
            await LoadEntriesAsync();
        }
    }

    private bool MatchesTheListFilters(TemplateEntry entry) =>
        (OptionalOf(_languageFilter) is not { } language || string.Equals(entry.Lookup.Language, language, StringComparison.OrdinalIgnoreCase))
        && (_partFilter.Length == 0 || string.Equals(entry.Lookup.Part, _partFilter, StringComparison.Ordinal))
        && (_kindFilter.Length == 0 || string.Equals(entry.Lookup.Kind.ToString(), _kindFilter, StringComparison.Ordinal));

    private void OpenNew()
    {
        if (_parts is not { IsSuccess: true } parts || !int.TryParse(_newPart, out var index) || index < 0 || index >= parts.Value.Count)
        {
            _newError = new Error(Errors.ValidationFailed, "Select a part.");
            return;
        }

        var part = parts.Value[index];
        var lookup = new TemplateLookup(part.Type, _newLanguage.Trim(), OptionalOf(_newCompany), part.Part.Name, part.Part.Kind);
        _newError = TemplateLookupRules.Check(lookup);
        if (_newError is null)
        {
            Navigation.NavigateTo(TemplateAdminRoutes.Edit(lookup).TrimStart('/'));
        }
    }

    private void OpenNewDialog() => (_newOpen, _newError) = (true, null);

    private void CloseNewDialog() => (_newOpen, _newError) = (false, null);

    private static IEnumerable<string> TypesOf(ErrorOr<IReadOnlyList<TemplatePartInfo>>? parts) =>
        parts is { IsSuccess: true } found ? found.Value.Select(static part => part.Type.Name).Distinct(StringComparer.Ordinal) : [];

    private static IEnumerable<string> PartNamesOf(ErrorOr<IReadOnlyList<TemplatePartInfo>>? parts) =>
        parts is { IsSuccess: true } found ? found.Value.Select(static part => part.Part.Name).Distinct(StringComparer.Ordinal) : [];

    private static string? OptionalOf(string value) => string.IsNullOrWhiteSpace(value) ? null : value.Trim();
}

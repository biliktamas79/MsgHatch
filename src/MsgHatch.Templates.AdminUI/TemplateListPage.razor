@attribute [Route(TemplateAdminRoutes.List)]
@inject IServiceProvider Services
@inject NavigationManager Navigation
@* The template list, with filters for the message type and the company, and a dialog of a new template from the declared parts (D240, D260). *@

<AdminListPage Title="Templates">
<Actions>
    <button type="button" class="btn btn-sm btn-primary" data-action="new" @onclick="OpenNewDialog">+ New template</button>
</Actions>
<Filters>
    <div>
        <label class="form-label small mb-1" for="msghatch-template-type">Message type</label>
        <select id="msghatch-template-type" class="form-select form-select-sm" @bind="_typeFilter">
            <option value="">All</option>
            @foreach (var type in TypesOf(_parts))
            {
                <option value="@type">@type</option>
            }
        </select>
    </div>
    <div>
        <label class="form-label small mb-1" for="msghatch-template-company">Company id</label>
        <input id="msghatch-template-company" class="form-control form-control-sm" @bind="_companyFilter" />
    </div>
    <div>
        <button type="button" class="btn btn-sm btn-secondary" data-action="filter" @onclick="LoadEntriesAsync">Show</button>
    </div>
</Filters>
<ChildContent>
<AdminList TItem="TemplateEntry" Items="_entries" EmptyText="There are no templates.">
    <Head>
        <tr><th>Message type</th><th>Language</th><th>Company</th><th>Part</th><th>Kind</th><th>Version</th><th></th></tr>
    </Head>
    <Row Context="entry">
        <tr data-row>
            <td>@entry.Lookup.Type.Name</td>
            <td>@entry.Lookup.Language</td>
            <td>@(entry.Lookup.Scope ?? "All companies")</td>
            <td>@entry.Lookup.Part</td>
            <td>@entry.Lookup.Kind</td>
            <td>@entry.Version</td>
            <td class="text-end text-nowrap">
                <a class="btn btn-sm btn-outline-secondary" data-action="view" href="@TemplateAdminRoutes.View(entry.Lookup).TrimStart('/')">View</a>
                <a class="btn btn-sm btn-outline-primary" data-action="edit" href="@TemplateAdminRoutes.Edit(entry.Lookup).TrimStart('/')">Edit</a>
            </td>
        </tr>
    </Row>
</AdminList>
</ChildContent>
</AdminListPage>

<AdminDialog Open="_newOpen" Title="New template">
    <ChildContent>
        @if (_parts is { IsError: true } failed)
        {
            <ErrorAlert Error="failed.Error" />
        }
        else if (_parts is { Value.Count: > 0 } parts)
        {
            <div data-form="new">
                <div class="mb-3">
                    <label class="form-label" for="msghatch-template-part">Part</label>
                    <select id="msghatch-template-part" class="form-select" @bind="_newPart">
                        @for (var index = 0; index < parts.Value.Count; index++)
                        {
                            var part = parts.Value[index];
                            <option value="@index">@part.Type.Name / @part.Part.Name / @part.Part.Kind</option>
                        }
                    </select>
                </div>
                <div class="mb-3">
                    <label class="form-label" for="msghatch-template-language">Language</label>
                    <input id="msghatch-template-language" class="form-control" @bind="_newLanguage" />
                </div>
                <div class="mb-3">
                    <label class="form-label" for="msghatch-template-new-company">Company id</label>
                    <input id="msghatch-template-new-company" class="form-control" @bind="_newCompany" />
                </div>
            </div>
            <ErrorAlert Error="_newError" />
        }
        else
        {
            <p class="text-secondary mb-0" data-state="no-parts">No message type declares a template part.</p>
        }
    </ChildContent>
    <Start>
        <button type="button" class="btn btn-outline-secondary" data-action="cancel-new" @onclick="CloseNewDialog">Cancel</button>
    </Start>
    <End>
        @if (_parts is { IsSuccess: true, Value.Count: > 0 })
        {
            <button type="button" class="btn btn-primary" data-action="open-editor" @onclick="OpenNew">Open the editor</button>
        }
    </End>
</AdminDialog>

@code {
    private ErrorOr<IReadOnlyList<TemplatePartInfo>>? _parts;
    private ErrorOr<IReadOnlyList<TemplateEntry>>? _entries;
    private string _typeFilter = string.Empty;
    private string _companyFilter = string.Empty;
    private string _newPart = "0";
    private string _newLanguage = "en";
    private string _newCompany = string.Empty;
    private Error? _newError;
    private bool _newOpen;

    private ITemplateQueries Queries => Services.GetRequiredKeyedService<ITemplateQueries>(TenantKey.None);

    /// <inheritdoc />
    protected override async Task OnInitializedAsync()
    {
        _parts = await Queries.GetTemplatePartsAsync(type: null, CancellationToken.None);
        await LoadEntriesAsync();
    }

    private async Task LoadEntriesAsync()
    {
        _entries = null;
        MessageType? type = null;
        if (_typeFilter.Length > 0)
        {
            var parsed = TemplateRouteValues.TypeOf(_typeFilter);
            if (parsed.IsError)
            {
                _entries = parsed.Error;
                return;
            }

            type = parsed.Value;
        }

        _entries = await Queries.GetTemplatesAsync(new TemplateQuery(type, OptionalOf(_companyFilter)), CancellationToken.None);
    }

    private void OpenNew()
    {
        if (_parts is not { IsSuccess: true } parts || !int.TryParse(_newPart, out var index) || index < 0 || index >= parts.Value.Count)
        {
            _newError = new Error(Errors.ValidationFailed, "Select a part.");
            return;
        }

        var part = parts.Value[index];
        var lookup = new TemplateLookup(part.Type, _newLanguage.Trim(), OptionalOf(_newCompany), part.Part.Name, part.Part.Kind);
        _newError = TemplateLookupRules.Check(lookup);
        if (_newError is null)
        {
            Navigation.NavigateTo(TemplateAdminRoutes.Edit(lookup).TrimStart('/'));
        }
    }

    private void OpenNewDialog() => (_newOpen, _newError) = (true, null);

    private void CloseNewDialog() => (_newOpen, _newError) = (false, null);

    private static IEnumerable<string> TypesOf(ErrorOr<IReadOnlyList<TemplatePartInfo>>? parts) =>
        parts is { IsSuccess: true } found ? found.Value.Select(static part => part.Type.Name).Distinct(StringComparer.Ordinal) : [];

    private static string? OptionalOf(string value) => string.IsNullOrWhiteSpace(value) ? null : value.Trim();
}

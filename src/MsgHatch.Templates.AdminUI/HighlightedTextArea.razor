@using Microsoft.JSInterop
@implements IAsyncDisposable
@* A text area over a highlighted copy of its text (D252). An editor gives the segments, and an engine package styles its own classes with ::deep. *@
<div class="highlighted-text-area">
    <pre class="highlight-layer form-control" aria-hidden="true" @ref="_layer">@foreach (var segment in Segments)
        {
            if (segment.Mark is { } mark)
            {
                <mark class="template-issue @segment.CssClass" data-mark="@mark">@Text.Substring(segment.Start, segment.Length)</mark>
            }
            else
            {
                <span class="@segment.CssClass">@Text.Substring(segment.Start, segment.Length)</span>
            }
        }@("\n")</pre>
    <textarea class="highlight-input form-control @(Invalid ? "is-invalid" : null)" spellcheck="false" aria-label="Template text" @ref="_input"
              value="@Text" disabled="@Disabled" readonly="@ReadOnly" @oninput="OnInputAsync"></textarea>
</div>

@code {
    private ElementReference _layer;
    private ElementReference _input;
    private IJSObjectReference? _module;

    /// <summary>The text.</summary>
    [Parameter, EditorRequired]
    public string Text { get; set; } = string.Empty;

    /// <summary>The segments of the text, in the order of the text, with no gap.</summary>
    [Parameter, EditorRequired]
    public IReadOnlyList<TextSegment> Segments { get; set; } = [];

    /// <summary>Gets each change of the text.</summary>
    [Parameter]
    public EventCallback<string> TextChanged { get; set; }

    /// <summary>True when the text has an issue, so the text area has the style of an invalid field.</summary>
    [Parameter]
    public bool Invalid { get; set; }

    /// <summary>True when the text area accepts no change.</summary>
    [Parameter]
    public bool Disabled { get; set; }

    /// <summary>True when the text area shows a text that the user can read, select, and copy, but not change (D257).</summary>
    [Parameter]
    public bool ReadOnly { get; set; }

    [Inject]
    private IJSRuntime JS { get; set; } = default!;

    /// <inheritdoc />
    public async ValueTask DisposeAsync()
    {
        if (_module is not null)
        {
            try
            {
                await _module.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
            }
        }
    }

    /// <inheritdoc />
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _module = await JS.InvokeAsync<IJSObjectReference>("import", "./_content/MsgHatch.Templates.AdminUI/highlightedTextArea.js");
            if (_module is not null)
            {
                await _module.InvokeVoidAsync("syncScroll", _input, _layer);
            }
        }
    }

    private Task OnInputAsync(ChangeEventArgs args) => TextChanged.InvokeAsync(args.Value as string ?? string.Empty);
}

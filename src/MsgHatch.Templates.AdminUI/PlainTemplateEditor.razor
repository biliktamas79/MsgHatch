@inherits TemplateEditorBase
@* The editor of a part with no registered editor, or with more than one engine (D240): the HTML highlight for an html part (D252), and a text area for a txt part. *@
@if (Lookup.Kind == TemplatePartKind.Html)
{
    <div data-editor="plain">
        <HighlightedTextArea Text="@Text" Segments="TextSegments.Of(Text, Lookup.Kind)" TextChanged="TextChanged" Invalid="Issues.Count > 0" Changed="Changed" Disabled="Disabled" />
    </div>
}
else
{
    <textarea class="form-control font-monospace @(Issues.Count > 0 ? "is-invalid" : Changed ? "border-warning" : null)" rows="16" spellcheck="false"
              aria-label="Template text" data-editor="plain" value="@Text" disabled="@Disabled" @oninput="OnInputAsync"></textarea>
}
@foreach (var issue in Issues)
{
    <div class="invalid-feedback d-block" data-issue>@TextOf(issue)</div>
}

@code {
    private Task OnInputAsync(ChangeEventArgs args) => TextChanged.InvokeAsync(args.Value as string ?? string.Empty);
}

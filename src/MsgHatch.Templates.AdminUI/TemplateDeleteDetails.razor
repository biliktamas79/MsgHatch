@* The details of a template in the delete question (D262): its metadata line, and what a send uses after the delete. *@
<TemplateMetadata Lookup="Lookup" Version="Version" VersionText="@VersionText" />
<p class="small text-secondary mb-0" data-delete-effect>
    After the delete, a send uses the next template of the fallback, for example the template with no company or the template
    of the default language. When no template is left, a required part, for example the subject, gives an error, and an
    optional part, for example the text body, is left out.
</p>

@code {
    /// <summary>The message type, the language, the template scope, the part, and the kind of the template to delete.</summary>
    [Parameter, EditorRequired]
    public TemplateLookup Lookup { get; set; }

    /// <summary>The stored version of the template to delete.</summary>
    [Parameter, EditorRequired]
    public long Version { get; set; }

    /// <summary>The text of the version that the store rendered (D267), or null to show the number.</summary>
    [Parameter]
    public string? VersionText { get; set; }

    /// <summary>Gives the question before the delete of a template.</summary>
    /// <param name="lookup">The template to delete.</param>
    /// <returns>For example <c>Do you want to delete the subject (PlainText) template of Requests in en?</c>.</returns>
    internal static string QuestionOf(TemplateLookup lookup) =>
        $"Do you want to delete the {lookup.Part} ({lookup.Kind}) template of {lookup.Type.Name} in {lookup.Language}?";
}

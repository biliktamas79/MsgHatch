<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Description>The HTTP client of the MsgHatch registry and delivery APIs: IRegistryQueries, IRegistryCommands, IDeliveryQueries, and IDeliveryCommands over HTTP.</Description>
    <PackageTags>messaging;api;http-client</PackageTags>
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\MsgHatch.Api.Contracts\MsgHatch.Api.Contracts.csproj" />
    <ProjectReference Include="..\MsgHatch.SourceGeneration\MsgHatch.SourceGeneration.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Http" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\Shared\ErrorProblems.cs" Link="Shared\ErrorProblems.cs" />
    <Compile Include="..\Shared\DeliveryApiRoutes.cs" Link="Shared\DeliveryApiRoutes.cs" />
    <Compile Include="..\Shared\RegistryApiRoutes.cs" Link="Shared\RegistryApiRoutes.cs" />
    <Compile Include="..\Shared\ApiResults.cs" Link="Shared\ApiResults.cs" />
  </ItemGroup>

</Project>

<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Description>The HTTP client of the MsgHatch subscription management API: ISubscriptionQueries, ISubscriptionCommands, and IRoutingVerifier over HTTP.</Description>
    <PackageTags>messaging;subscriptions;api;http-client</PackageTags>
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\MsgHatch.Subscriptions.Api.Contracts\MsgHatch.Subscriptions.Api.Contracts.csproj" />
    <ProjectReference Include="..\MsgHatch.SourceGeneration\MsgHatch.SourceGeneration.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Http" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\Shared\ErrorProblems.Responses.cs" Link="Shared\ErrorProblems.Responses.cs" />
    <Compile Include="..\Shared\SubscriptionApiRoutes.cs" Link="Shared\SubscriptionApiRoutes.cs" />
    <Compile Include="..\Shared\ApiResults.cs" Link="Shared\ApiResults.cs" />
  </ItemGroup>

</Project>

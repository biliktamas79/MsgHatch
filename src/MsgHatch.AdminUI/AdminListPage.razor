@* The layout of an admin list page (D259): a header with the title, a toolbar with the filters on the left and the actions on the right, and the list, which scrolls by itself in a host whose main area has a fixed height. *@
<div class="admin-list-page d-flex flex-column flex-grow-1" data-list-page>
    <div class="flex-shrink-0" data-list-header>
        <div class="d-flex flex-wrap align-items-center gap-2 mb-2">
            <h1 class="h3 mb-0 me-auto">@Title</h1>
            @Links
        </div>
        <div class="d-flex flex-wrap align-items-end gap-3 mb-3" data-list-toolbar>
            <div class="d-flex flex-wrap align-items-end gap-2" data-list-filters>@Filters</div>
            <div class="ms-auto" data-list-actions>@Actions</div>
        </div>
    </div>
    <div class="admin-list-body d-flex flex-column flex-grow-1" data-list-body>
        @ChildContent
    </div>
</div>

@code {
    /// <summary>The title of the page.</summary>
    [Parameter]
    public string Title { get; set; } = string.Empty;

    /// <summary>The links next to the title, for example to other pages of the admin UI.</summary>
    [Parameter]
    public RenderFragment? Links { get; set; }

    /// <summary>The filters of the list, on the left of the toolbar.</summary>
    [Parameter]
    public RenderFragment? Filters { get; set; }

    /// <summary>The actions of the list, on the right of the toolbar, for example the button of a new item (D260).</summary>
    [Parameter]
    public RenderFragment? Actions { get; set; }

    /// <summary>The list, usually an <see cref="AdminList{TItem}"/>.</summary>
    [Parameter]
    public RenderFragment? ChildContent { get; set; }
}

@typeparam TItem
@* The list of an admin page with the states loading, error, and empty, and a pager (D239). The table is in an area that scrolls by itself, with a sticky row of column names, and the pager is under it (D259). A list of server pages gives its own pager, which replaces the page numbers (D295). *@
@if (Items is not { } items)
{
    <p class="text-secondary" role="status" data-state="loading">Loading.</p>
}
else if (items.IsError)
{
    <ErrorAlert Error="items.Error" />
}
else if (items.Value.Count == 0)
{
    <p class="text-secondary" data-state="empty">@EmptyText</p>
    @if (Pager is not null)
    {
        <div class="flex-shrink-0 pt-2" data-list-pager>@Pager</div>
    }
}
else
{
    <div class="admin-list-scroll flex-grow-1 border rounded" data-list-scroll>
        <table class="table table-sm table-hover align-middle mb-0">
            @if (Head is not null)
            {
                <thead>@Head</thead>
            }
            <tbody>
                @foreach (var item in Pager is null ? PageOf(items.Value) : items.Value)
                {
                    @Row?.Invoke(item)
                }
            </tbody>
        </table>
    </div>
    <div class="flex-shrink-0 pt-2" data-list-pager>
        @if (Pager is null)
        {
            <AdminPager Page="_page" PageCount="PageCountOf(items.Value.Count)" PageChanged="page => _page = page" />
        }
        else
        {
            @Pager
        }
    </div>
}

@code {
    private int _page;

    /// <summary>The items, an error, or null while the page loads them.</summary>
    [Parameter]
    public ErrorOr<IReadOnlyList<TItem>>? Items { get; set; }

    /// <summary>The row of the column names.</summary>
    [Parameter]
    public RenderFragment? Head { get; set; }

    /// <summary>The row of one item.</summary>
    [Parameter]
    public RenderFragment<TItem>? Row { get; set; }

    /// <summary>The text of an empty list.</summary>
    [Parameter]
    public string EmptyText { get; set; } = "There are no items.";

    /// <summary>
    /// The pager of a list of server pages, for example <see cref="CursorPager"/>, or null for the page numbers of the list. With a
    /// pager, the list shows each item that it gets, and shows the pager also under an empty page (D295).
    /// </summary>
    [Parameter]
    public RenderFragment? Pager { get; set; }

    /// <summary>The number of items on one page, 25 by default.</summary>
    [Parameter]
    public int PageSize { get; set; } = 25;

    /// <inheritdoc />
    protected override void OnParametersSet()
    {
        var count = Items is { IsSuccess: true } items ? items.Value.Count : 0;
        _page = Math.Clamp(_page, 0, Math.Max(PageCountOf(count) - 1, 0));
    }

    private int PageCountOf(int count) => (count + Math.Max(PageSize, 1) - 1) / Math.Max(PageSize, 1);

    private IEnumerable<TItem> PageOf(IReadOnlyList<TItem> items) => items.Skip(_page * Math.Max(PageSize, 1)).Take(Math.Max(PageSize, 1));
}

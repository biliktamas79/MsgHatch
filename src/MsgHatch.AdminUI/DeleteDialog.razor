@* The question before a delete or a reset, with the details of the item (D239, D261, D262, D287). The action runs only after the user confirms it. *@
<AdminDialog Open="Open" Title="@Action">
    <ChildContent>
        <p>@Question</p>
        @if (Details is not null)
        {
            <div class="mb-3" data-delete-details>@Details</div>
        }
        <p class="text-danger mb-0" data-delete-warning>The @Action.ToLowerInvariant() cannot be undone.</p>
    </ChildContent>
    <Start>
        <button type="button" class="btn btn-outline-secondary" data-action="cancel-delete" @onclick="() => Cancelled.InvokeAsync()">Cancel</button>
    </Start>
    <End>
        <button type="button" class="btn btn-danger" data-action="confirm-delete" @onclick="() => Confirmed.InvokeAsync()">@Action</button>
    </End>
</AdminDialog>

@code {
    /// <summary>
    /// The action that the dialog asks for, for example "Reset". It is the title, the text of the button, and the noun of the
    /// warning, for example "The reset cannot be undone." (D287).
    /// </summary>
    [Parameter]
    public string Action { get; set; } = "Delete";

    /// <summary>True when the dialog shows the question.</summary>
    [Parameter]
    public bool Open { get; set; }

    /// <summary>The question, for example the name of the item to delete.</summary>
    [Parameter]
    public string Question { get; set; } = "Do you want to delete this item?";

    /// <summary>The details of the item to delete, and what changes after the delete, or null for no details.</summary>
    [Parameter]
    public RenderFragment? Details { get; set; }

    /// <summary>Runs when the user confirms the delete.</summary>
    [Parameter]
    public EventCallback Confirmed { get; set; }

    /// <summary>Runs when the user cancels the delete.</summary>
    [Parameter]
    public EventCallback Cancelled { get; set; }
}

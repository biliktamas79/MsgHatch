<Project>

  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <ItemGroup Label="MsgHatch.Domain">
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.14" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.14" />
    <PackageVersion Include="Microsoft.Extensions.Options" Version="10.0.14" />
    <PackageVersion Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="10.0.14" />
    <PackageVersion Include="Microsoft.Extensions.Diagnostics" Version="10.0.14" />
  </ItemGroup>

  <ItemGroup Label="MsgHatch.SourceGeneration">
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp" Version="5.0.0" />
    <PackageVersion Include="Microsoft.CodeAnalysis.Analyzers" Version="3.11.0" />
  </ItemGroup>

  <ItemGroup Label="MsgHatch.Email.AmazonSES">
    <PackageVersion Include="AWSSDK.SimpleEmailV2" Version="4.0.106.7" />
  </ItemGroup>

  <ItemGroup Label="MsgHatch.Email.Resend">
    <PackageVersion Include="Microsoft.Extensions.Http" Version="10.0.14" />
  </ItemGroup>

  <ItemGroup Label="MsgHatch.Broker.Wolverine">
    <PackageVersion Include="WolverineFx" Version="6.61.0" />
  </ItemGroup>

  <ItemGroup Label="MsgHatch.Data.Sqlite">
    <PackageVersion Include="Microsoft.Data.Sqlite" Version="10.0.14" />
  </ItemGroup>

  <ItemGroup Label="MsgHatch.Data.EFCore">
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.14" />
  </ItemGroup>

  <ItemGroup Label="MsgHatch.Data.MongoDb">
    <PackageVersion Include="MongoDB.Driver" Version="3.14.0" />
  </ItemGroup>

  <ItemGroup Label="MsgHatch.Subscriptions.Caching.Hybrid">
    <PackageVersion Include="Microsoft.Extensions.Caching.Hybrid" Version="10.11.0" />
  </ItemGroup>

  <ItemGroup Label="MsgHatch.Subscriptions.Caching.FusionCache">
    <PackageVersion Include="ZiggyCreatures.FusionCache" Version="2.9.0" />
  </ItemGroup>

  <ItemGroup Label="ExampleApp and WolverineExample.Consumer">
    <PackageVersion Include="OpenTelemetry.Extensions.Hosting" Version="1.20.1" />
    <PackageVersion Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.20.1" />
    <PackageVersion Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.14" />
    <PackageVersion Include="WolverineFx.RuntimeCompilation" Version="6.61.0" />
  </ItemGroup>

  <ItemGroup Label="ExampleApp.Tests.Unit">
    <PackageVersion Include="OpenTelemetry.Exporter.InMemory" Version="1.20.1" />
  </ItemGroup>

  <ItemGroup Label="MsgHatch.AspNetCore.Tests.Unit and MsgHatch.Subscriptions.AspNetCore.Tests.Unit">
    <PackageVersion Include="Microsoft.AspNetCore.TestHost" Version="10.0.14" />
  </ItemGroup>

  <ItemGroup Label="MsgHatch.Broker.Wolverine.Tests.Integration and the WolverineExample apps">
    <PackageVersion Include="WolverineFx.RabbitMQ" Version="6.61.0" />
  </ItemGroup>

  <ItemGroup Label="EF Core integration tests">
    <PackageVersion Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.14" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.14" />
    <PackageVersion Include="Microsoft.Data.SqlClient" Version="6.1.8" />
    <PackageVersion Include="Testcontainers.MsSql" Version="4.16.0" />
  </ItemGroup>

  <ItemGroup Label="MongoDB integration tests">
    <PackageVersion Include="Testcontainers.MongoDb" Version="4.16.0" />
  </ItemGroup>

  <ItemGroup Label="Performance tests">
    <PackageVersion Include="BenchmarkDotNet" Version="0.15.8" />
  </ItemGroup>

  <ItemGroup Label="Analyzers">
    <PackageVersion Include="Microsoft.CodeAnalysis.BannedApiAnalyzers" Version="3.3.4" />
  </ItemGroup>

  <ItemGroup Label="Tests">
    <PackageVersion Include="xunit.v3" Version="4.0.2" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="4.0.1" />
    <PackageVersion Include="NSubstitute" Version="6.2.0" />
    <PackageVersion Include="NSubstitute.Analyzers.CSharp" Version="1.0.17" />
    <PackageVersion Include="Microsoft.Extensions.TimeProvider.Testing" Version="10.11.0" />
    <PackageVersion Include="Microsoft.Extensions.Diagnostics.Testing" Version="10.11.0" />
    <PackageVersion Include="coverlet.collector" Version="10.1.0" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="10.0.14" />
    <PackageVersion Include="Microsoft.Extensions.Configuration" Version="10.0.14" />
    <PackageVersion Include="Microsoft.Extensions.Configuration.Json" Version="10.0.14" />
  </ItemGroup>

</Project>

@inherits LayoutComponentBase
@* One column with the height of the window: the main area fills the rest, so a list page scrolls only its list (D259). *@

<div class="d-flex flex-column vh-100">
    <nav class="navbar navbar-expand bg-body-tertiary border-bottom py-0 flex-shrink-0">
        <div class="container">
            <a class="navbar-brand" href="">MsgHatch admin</a>
            <ul class="navbar-nav">
                <li class="nav-item"><NavLink class="nav-link" href="@RegistryAdminRoutes.Channels.TrimStart('/')">Channels</NavLink></li>
                <li class="nav-item"><NavLink class="nav-link" href="@RegistryAdminRoutes.MessageTypes.TrimStart('/')">Message types</NavLink></li>
                <li class="nav-item"><SectionNavLink class="nav-link" href="@SubscriptionAdminRoutes.List.TrimStart('/')" Except="[SubscriptionAdminRoutes.Verification]">Subscriptions</SectionNavLink></li>
                <li class="nav-item"><NavLink class="nav-link" href="@TemplateAdminRoutes.List.TrimStart('/')">Templates</NavLink></li>
                <li class="nav-item"><NavLink class="nav-link" href="@SubscriptionAdminRoutes.Verification.TrimStart('/')">Verification</NavLink></li>
            </ul>
            <button type="button" class="btn btn-sm btn-outline-secondary ms-auto" data-theme-toggle onclick="msghatchTheme.toggle()">Light or dark</button>
        </div>
    </nav>

    <main class="container d-flex flex-column flex-grow-1 py-3" style="min-height: 0; overflow-y: auto;">
        @Body
    </main>
</div>
